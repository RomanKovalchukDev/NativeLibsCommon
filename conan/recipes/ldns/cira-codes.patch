From 08201f31f88d1e5d4b4a785cef923a22f181a23f Mon Sep 17 00:00:00 2001
From: Roman Kovalchuk <romankovalchuk@nerdzlab.com>
Date: Tue, 9 Sep 2025 12:31:13 +0300
Subject: [PATCH] Added CIRA edns option codes

---
 ldns/edns.h | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/ldns/edns.h b/ldns/edns.h
index a33ed055..ee9bdcdf 100644
--- a/ldns/edns.h
+++ b/ldns/edns.h
@@ -41,7 +41,9 @@ enum ldns_enum_edns_option
 	LDNS_EDNS_KEY_TAG = 14, /* RFC8145 */
 	LDNS_EDNS_EDE = 15, /* RFC8914 */
 	LDNS_EDNS_CLIENT_TAG = 16, /* draft-bellis-dnsop-edns-tags-01 */
-	LDNS_EDNS_SERVER_TAG = 17 /* draft-bellis-dnsop-edns-tags-01 */
+	LDNS_EDNS_SERVER_TAG = 17, /* draft-bellis-dnsop-edns-tags-01 */
+	LDNS_EDNS_CIRA_DEVICE_ID = 65001,
+	LDNS_EDNS_CIRA_SUBSCRIBER_ID = 65075
 };
 typedef enum ldns_enum_edns_option ldns_edns_option_code;
 

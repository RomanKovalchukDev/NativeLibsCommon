From: Roman Kovalchuk <romankovalchuk@nerdzlab.com>
Date: Thu, 28 Aug 2025 15:59:07 +0300
Subject: [PATCH] Added checks for not defined windows module

---
 host2str.c      | 2 ++
 ldns/packet.h   | 3 +++
 ldns/resolver.h | 3 +++
 net.c           | 2 ++
 util.c          | 2 ++
 5 files changed, 12 insertions(+)

diff --git a/host2str.c b/host2str.c
index deeeaf63..b22d7981 100644
--- a/host2str.c
+++ b/host2str.c
@@ -26,7 +26,9 @@
 #include <netdb.h>
 #endif
 #include <time.h>
+#ifndef _MSC_VER
 #include <sys/time.h>
+#endif
 
 #ifdef HAVE_SSL
 #include <openssl/bn.h>
diff --git a/ldns/packet.h b/ldns/packet.h
index 2c60609f..62244228 100644
--- a/ldns/packet.h
+++ b/ldns/packet.h
@@ -32,11 +32,14 @@
 #define LDNS_RA		32      /* Recursion Available - server flag */
 #define LDNS_AD		64      /* Authenticated Data - server flag */
 
+#include <ldns/config.h>
 #include <ldns/error.h>
 #include <ldns/common.h>
 #include <ldns/rr.h>
 #include <ldns/edns.h>
+#ifndef _MSC_VER
 #include <sys/time.h>
+#endif
 
 #ifdef __cplusplus
 extern "C" {
diff --git a/ldns/resolver.h b/ldns/resolver.h
index e8459db7..642be84c 100644
--- a/ldns/resolver.h
+++ b/ldns/resolver.h
@@ -20,13 +20,16 @@
 #ifndef LDNS_RESOLVER_H
 #define LDNS_RESOLVER_H
 
+#include <ldns/config.h>
 #include <ldns/error.h>
 #include <ldns/common.h>
 #include <ldns/rr.h>
 #include <ldns/tsig.h>
 #include <ldns/rdata.h>
 #include <ldns/packet.h>
+#ifndef _MSC_VER
 #include <sys/time.h>
+#endif
 
 #ifdef __cplusplus
 extern "C" {
diff --git a/net.c b/net.c
index 8fc9c8c4..e742e81d 100644
--- a/net.c
+++ b/net.c
@@ -27,7 +27,9 @@
 #ifdef HAVE_ARPA_INET_H
 #include <arpa/inet.h>
 #endif
+#ifndef _MSC_VER
 #include <sys/time.h>
+#endif
 #include <errno.h>
 #include <fcntl.h>
 #ifdef HAVE_POLL
diff --git a/util.c b/util.c
index 662aa23a..73ad4b74 100644
--- a/util.c
+++ b/util.c
@@ -18,7 +18,9 @@
 #include <strings.h>
 #include <stdlib.h>
 #include <stdio.h>
+#ifndef _MSC_VER
 #include <sys/time.h>
+#endif
 #include <time.h>
 #include <ctype.h>
 
